---
import Icon from '../ui/Icon.astro';

interface UseCase {
  icon: string;
  audience: string;
  scenario: string;
}

interface Props {
  useCases: UseCase[];
  eyebrow?: string;
  title?: string;
  subtitle?: string;
}

const {
  useCases,
  eyebrow = 'Built for every workflow',
  title = 'Who uses it, and how',
  subtitle,
} = Astro.props;
---

<section class="usecases-section">
  <div class="usecases-container">
    <div class="usecases-header">
      <span class="usecases-eyebrow">{eyebrow}</span>
      <h2 class="usecases-title">{title}</h2>
      {subtitle && <p class="usecases-subtitle">{subtitle}</p>}
    </div>

    <div class="usecases-grid">
      {useCases.map((uc, i) => (
        <div class="usecase-row" data-usecase-row>
          <div class="usecase-number">0{i + 1}</div>
          <div class="usecase-icon">
            <Icon name={uc.icon} size={22} />
          </div>
          <div class="usecase-body">
            <div class="usecase-audience">{uc.audience}</div>
            <p class="usecase-scenario">{uc.scenario}</p>
          </div>
          <div class="usecase-arrow" aria-hidden="true">
            <Icon name="arrow-right" size={18} />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .usecases-section {
    background: var(--dw-bg);
    padding: 6rem 0;
  }

  .usecases-container {
    max-width: 68rem;
    margin: 0 auto;
    padding: 0 1rem;
  }

  @media (min-width: 640px) {
    .usecases-container { padding: 0 1.5rem; }
  }

  .usecases-header {
    text-align: center;
    max-width: 42rem;
    margin: 0 auto 3rem;
  }

  .usecases-eyebrow {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--dw-border);
    border-radius: 999px;
    background: var(--dw-accent-bg);
  }

  .usecases-title {
    margin-top: 1rem;
    font-family: var(--font-headline, 'Manrope', sans-serif);
    font-size: clamp(1.875rem, 4vw, 2.75rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--dw-text);
    letter-spacing: -0.01em;
  }

  .usecases-subtitle {
    margin-top: 0.75rem;
    font-size: 1.05rem;
    color: var(--dw-text-secondary);
    line-height: 1.55;
  }

  .usecases-grid {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .usecase-row {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem 1.75rem;
    background: var(--dw-surface);
    border: 1px solid var(--dw-border);
    border-radius: 20px;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.3s ease, box-shadow 0.35s ease, background 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .usecase-row::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--dw-accent-bg) 0%, transparent 40%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .usecase-row:hover {
    transform: translateX(6px);
    border-color: var(--color-primary-200, rgba(0, 82, 50, 0.3));
    box-shadow: 0 14px 32px -14px rgba(0, 82, 50, 0.2);
  }

  .usecase-row:hover::before {
    opacity: 1;
  }

  .usecase-number {
    position: relative;
    font-family: var(--font-headline, 'Manrope', sans-serif);
    font-size: 1rem;
    font-weight: 700;
    color: var(--dw-text-muted);
    letter-spacing: 0.05em;
    width: 2rem;
    z-index: 2;
  }

  .usecase-icon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--dw-accent-bg);
    color: var(--color-primary);
    flex-shrink: 0;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), background 0.3s ease, color 0.3s ease;
    z-index: 2;
  }

  .usecase-row:hover .usecase-icon {
    transform: scale(1.08) rotate(-4deg);
    background: var(--color-primary);
    color: #ffffff;
  }

  .usecase-body {
    position: relative;
    min-width: 0;
    z-index: 2;
  }

  .usecase-audience {
    font-family: var(--font-headline, 'Manrope', sans-serif);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--dw-text);
    line-height: 1.3;
    margin-bottom: 0.2rem;
  }

  .usecase-scenario {
    font-size: 0.925rem;
    line-height: 1.55;
    color: var(--dw-text-secondary);
    margin: 0;
  }

  .usecase-arrow {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--dw-text-muted);
    opacity: 0;
    transform: translateX(-10px);
    transition: opacity 0.4s ease, transform 0.4s ease, color 0.3s ease;
    flex-shrink: 0;
    z-index: 2;
  }

  .usecase-row:hover .usecase-arrow {
    opacity: 1;
    transform: translateX(0);
    color: var(--color-primary);
  }

  /* Stack on mobile */
  @media (max-width: 640px) {
    .usecase-row {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        'num icon'
        'body body'
        'arrow arrow';
      padding: 1.25rem;
      gap: 0.75rem 1rem;
    }
    .usecase-number { grid-area: num; }
    .usecase-icon { grid-area: icon; }
    .usecase-body { grid-area: body; }
    .usecase-arrow { display: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!prefersReducedMotion) {
    ScrollTrigger.batch('[data-usecase-row]', {
      onEnter: (elements) => {
        gsap.from(elements, {
          x: -30,
          opacity: 0,
          duration: 0.7,
          ease: 'power3.out',
          stagger: 0.09,
          overwrite: true,
        });
      },
      start: 'top 88%',
      once: true,
    });
  }
</script>
