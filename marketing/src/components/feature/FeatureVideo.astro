---
import Section from '../ui/Section.astro';

interface Props {
  youtubeId: string;
  title: string;
  description?: string;
  thumbnail?: string;
  eyebrow?: string;
  heading?: string;
}

const { youtubeId, title, description, thumbnail, eyebrow = 'Walkthrough', heading } = Astro.props;
const poster = thumbnail || `https://i.ytimg.com/vi/${youtubeId}/maxresdefault.jpg`;
const sectionHeading = heading || 'Watch the walkthrough';
---

<Section>
  <div class="feature-video-wrap">
    <div class="text-center mb-8">
      <span class="text-xs font-semibold tracking-widest uppercase text-[var(--color-primary)]">{eyebrow}</span>
      <h2 class="mt-2 text-2xl sm:text-3xl font-bold" style="font-family: var(--font-headline, 'Manrope', sans-serif);">
        {sectionHeading}
      </h2>
      {description && (
        <p class="mt-3 max-w-2xl mx-auto text-[var(--dw-text-muted)]">{description}</p>
      )}
    </div>

    <div class="feature-video-frame" data-youtube-id={youtubeId} data-title={title}>
      <button
        type="button"
        class="feature-video-poster"
        aria-label={`Play: ${title}`}
        style={`background-image: url('${poster}');`}
      >
        <span class="feature-video-play" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        </span>
      </button>
    </div>
  </div>
</Section>

<style>
  .feature-video-wrap {
    max-width: 56rem;
    margin: 0 auto;
  }
  .feature-video-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.45);
    background: #000;
  }
  .feature-video-poster {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    border: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.4s ease;
    padding: 0;
  }
  .feature-video-poster:hover { transform: scale(1.015); }
  .feature-video-poster::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(0,0,0,0.35) 100%);
    pointer-events: none;
  }
  .feature-video-play {
    position: relative;
    width: 76px;
    height: 76px;
    border-radius: 999px;
    background: var(--color-primary, #005232);
    color: white;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 20px 50px -10px rgba(0,82,50,0.6);
    transition: transform 0.2s ease;
  }
  .feature-video-poster:hover .feature-video-play { transform: scale(1.08); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.feature-video-frame').forEach((frame) => {
    const btn = frame.querySelector<HTMLButtonElement>('.feature-video-poster');
    const id = frame.dataset.youtubeId;
    const title = frame.dataset.title || 'YouTube video';
    if (!btn || !id) return;
    btn.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = title;
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.loading = 'lazy';
      iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;';
      btn.replaceWith(iframe);
    }, { once: true });
  });
</script>
