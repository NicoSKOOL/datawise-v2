---
interface Props {
  label?: string;
  title: string;
  description: string;
  areaClass?: string;
}

const { label, title, description, areaClass = '' } = Astro.props;
---

<div class:list={['bento-card', areaClass]}>
  <div class="bento-spotlight" aria-hidden="true"></div>
  <div class="bento-border-glow" aria-hidden="true"></div>

  <div class="bento-card-inner">
    <div class="bento-card-head">
      {label && <span class="bento-card-label">{label}</span>}
      <h3 class="bento-card-title">{title}</h3>
    </div>
    <p class="bento-card-desc">{description}</p>
  </div>
</div>

<style>
  .bento-card {
    position: relative;
    overflow: hidden;
    border-radius: 24px;
    background: #0a0f0d;
    border: 1px solid rgba(255, 255, 255, 0.06);
    padding: 1.5rem 1.5rem 1.75rem;
    min-height: 200px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: border-color 0.3s ease;
  }

  .bento-card:hover {
    border-color: rgba(var(--bento-glow, 46, 204, 113), 0.35);
  }

  /* Radial spotlight following mouse */
  .bento-spotlight {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      var(--bento-spotlight-radius, 320px) circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(var(--bento-glow, 46, 204, 113), 0.18),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .bento-card:hover .bento-spotlight {
    opacity: 1;
  }

  /* Border glow (masked) */
  .bento-border-glow {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: radial-gradient(
      var(--bento-spotlight-radius, 320px) circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(var(--bento-glow, 46, 204, 113), 0.8),
      transparent 45%
    );
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .bento-card:hover .bento-border-glow {
    opacity: 1;
  }

  .bento-card-inner {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    gap: 1rem;
  }

  .bento-card-label {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(var(--bento-glow, 46, 204, 113), 0.85);
    opacity: 0.75;
    transition: opacity 0.3s ease;
  }

  .bento-card:hover .bento-card-label {
    opacity: 1;
  }

  .bento-card-title {
    margin-top: 0.35rem;
    font-family: var(--font-headline, 'Manrope', sans-serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: #f5f7f6;
    line-height: 1.3;
  }

  .bento-card-desc {
    font-size: 0.9rem;
    line-height: 1.55;
    color: rgba(229, 231, 235, 0.65);
  }
</style>
