---
const currentYear = new Date().getFullYear();

const footerLinks = {
  Product: [
    { label: 'Features', href: '/features' },
    { label: 'Pricing', href: '/pricing' },
    { label: 'Blog', href: '/blog' },
  ],
  Tools: [
    { label: 'Keyword Research', href: '/features/keyword-research' },
    { label: 'Competitor Analysis', href: '/features/competitor-analysis' },
    { label: 'AI Visibility', href: '/features/ai-visibility' },
    { label: 'Rank Tracking', href: '/features/rank-tracking' },
  ],
  Company: [
    { label: 'About', href: '/about' },
    { label: 'What is AI Ranking?', href: '/community' },
    { label: 'Join on Skool', href: 'https://www.skool.com/ai-ranking' },
    { label: 'Log in', href: 'https://datawiseseo.com/' },
  ],
};
---

<footer class="border-t border-[var(--dw-border)] bg-[var(--dw-surface)]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="flex items-center gap-2.5" aria-label="DataWise SEO home">
          <img
            src="/images/logo/datawise-icon.webp"
            alt=""
            width="32"
            height="32"
            class="h-8 w-8"
          />
          <span class="font-[var(--font-headline)] font-bold text-lg text-[var(--dw-text)]">DataWise</span>
        </a>
        <p class="mt-4 text-sm text-[var(--dw-text-secondary)] max-w-xs">
          AI-powered SEO intelligence. Included with your AI Ranking community membership.
        </p>
        <a
          href="https://www.skool.com/ai-ranking"
          class="mt-4 inline-flex items-center rounded-lg bg-[var(--dw-primary-highlight)] px-4 py-2 text-sm font-semibold text-white hover:opacity-90 transition-colors"
        >
          Join AI Ranking
        </a>
      </div>

      <!-- Link Groups -->
      {Object.entries(footerLinks).map(([title, links]) => (
        <div>
          <h3 class="text-sm font-semibold font-[var(--font-headline)] text-[var(--dw-text)]">
            {title}
          </h3>
          <ul class="mt-4 space-y-2.5">
            {links.map(link => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-[var(--dw-text-secondary)] hover:text-[var(--dw-primary-highlight)] transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 pt-8 border-t border-[var(--dw-border)]">
      <p class="text-sm text-[var(--dw-text-muted)]">
        &copy; {currentYear} DataWise SEO. All rights reserved.
      </p>
    </div>
  </div>
</footer>
