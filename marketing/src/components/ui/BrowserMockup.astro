---
interface Props {
  src: string;
  alt: string;
  url?: string;
  class?: string;
}

const { src, alt, url = 'app.datawiseseo.com', class: className = '' } = Astro.props;
---

<div class:list={['rounded-xl overflow-hidden shadow-[var(--shadow-elevated)] border border-[var(--color-border)]', className]}>
  <!-- Browser chrome -->
  <div class="flex items-center gap-2 bg-[var(--color-surface-sunken)] border-b border-[var(--color-border)] px-4 py-2.5">
    <div class="flex gap-1.5">
      <div class="h-3 w-3 rounded-full bg-red-400/60"></div>
      <div class="h-3 w-3 rounded-full bg-yellow-400/60"></div>
      <div class="h-3 w-3 rounded-full bg-green-400/60"></div>
    </div>
    <div class="flex-1 flex justify-center">
      <div class="flex items-center gap-1.5 rounded-md bg-[var(--color-surface-elevated)] border border-[var(--color-border-light)] px-3 py-1 text-xs text-[var(--color-text-muted)] max-w-xs w-full justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        {url}
      </div>
    </div>
  </div>
  <!-- Screenshot -->
  <img
    src={src}
    alt={alt}
    class="w-full h-auto block bg-[var(--color-surface)]"
    loading="lazy"
    decoding="async"
  />
</div>
