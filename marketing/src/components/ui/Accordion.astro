---
interface Props {
  items: Array<{ question: string; answer: string }>;
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<div class:list={['divide-y divide-[var(--color-border)]', className]}>
  {items.map((item) => (
    <details class="group py-4 first:pt-0 last:pb-0">
      <summary class="flex cursor-pointer items-center justify-between gap-4 text-left font-semibold text-[var(--color-text-primary)] hover:text-[var(--color-primary)] transition-colors list-none [&::-webkit-details-marker]:hidden">
        <span>{item.question}</span>
        <svg
          class="h-5 w-5 shrink-0 text-[var(--color-text-muted)] transition-transform duration-200 group-open:rotate-180"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m6 9 6 6 6-6" />
        </svg>
      </summary>
      <p class="mt-3 text-[var(--color-text-secondary)] leading-relaxed">
        {item.answer}
      </p>
    </details>
  ))}
</div>
