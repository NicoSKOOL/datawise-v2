---
import Section from '../ui/Section.astro';
import Icon from '../ui/Icon.astro';
import Card from '../ui/Card.astro';
import AppScreenshot from '../ui/AppScreenshot.astro';

const showcaseFeatures = [
  {
    icon: 'search',
    title: 'Keyword Research Tool',
    description: 'Find high-value keywords with difficulty scores, search volume data, and AI-generated suggestions. Discover what your audience is actually searching for and which terms you can realistically rank for.',
    href: '/features/keyword-research',
    screenshot: '/images/screenshots/keyword-research.jpg',
    screenshotAlt: 'DataWise keyword suggestions tool showing search volume, CPC, and competition data for seed keywords',
  },
  {
    icon: 'bar-chart',
    title: 'SEO Competitor Analysis',
    description: 'See exactly which keywords your competitors rank for, estimate their organic traffic, and find content gaps you can exploit. Benchmark your domain against any competitor in seconds.',
    href: '/features/competitor-analysis',
    screenshot: '/images/screenshots/competitor-analysis.jpg',
    screenshotAlt: 'Competitor analysis showing domain rank comparison, competitive profile radar chart, and position distribution',
  },
  {
    icon: 'trending-up',
    title: 'Local Rank Tracking with GeoGrid',
    description: 'Track your local rankings across a geographic grid. See exactly where you rank for keywords in your service area with our visual GeoGrid map, powered by real-time data.',
    href: '/features/rank-tracking',
    screenshot: '/images/screenshots/rank-tracking.jpg',
    screenshotAlt: 'GeoGrid rank map showing local keyword positions across Melbourne for "irish pub" search',
  },
];

const compactFeatures = [
  {
    icon: 'robot',
    title: 'AI Visibility',
    description: 'Track your presence in AI-powered search results across Google AI Mode, ChatGPT, and Perplexity.',
    href: '/features/ai-visibility',
  },
  {
    icon: 'message-circle',
    title: 'AI SEO Assistant',
    description: 'Chat with an AI that analyzes your Search Console data and delivers actionable optimization insights.',
    href: '/features/seo-assistant',
  },
  {
    icon: 'pen-tool',
    title: 'Content Optimization',
    description: 'Revive underperforming pages and optimize service content for better rankings and conversions.',
    href: '/features/content-tools',
  },
];

// Pill quick-nav: every feature, scrollable on small viewports
const pillFeatures = [
  { icon: 'search',         title: 'Keyword Research',     href: '/features/keyword-research' },
  { icon: 'bar-chart',      title: 'Competitor Analysis',  href: '/features/competitor-analysis' },
  { icon: 'trending-up',    title: 'Rank Tracking',        href: '/features/rank-tracking' },
  { icon: 'robot',          title: 'AI Visibility',        href: '/features/ai-visibility' },
  { icon: 'search',         title: 'Fan-out Queries',     href: '/features/fan-out-queries' },
  { icon: 'globe',          title: 'Backlinks',            href: '/features/backlinks' },
  { icon: 'shield',         title: 'Site Audit',           href: '/features/site-audit' },
  { icon: 'message-circle', title: 'AI SEO Assistant',     href: '/features/seo-assistant' },
  { icon: 'pen-tool',       title: 'Content Writer',       href: '/features/content-writer' },
  { icon: 'check-circle',   title: 'Content Tools',        href: '/features/content-tools' },
];
---

<Section id="features" bg="white">
  <div class="text-center mb-10">
    <h2 class="text-3xl sm:text-4xl font-bold text-[var(--dw-text)] feature-heading">
      Every SEO tool you need, one membership
    </h2>
    <p class="mt-4 text-lg text-[var(--dw-text)]/70 max-w-2xl mx-auto feature-sub">
      The same keyword research, competitor analysis, and rank tracking that agencies pay hundreds for. Included with your AI Ranking membership from $27/mo.
    </p>
  </div>

  <!-- Pill quick-nav: every feature, scrollable -->
  <div class="home-pillnav-wrap mb-16">
    <button
      type="button"
      class="home-pillnav-arrow home-pillnav-arrow--left"
      id="home-pillnav-prev"
      aria-label="Scroll features left"
      tabindex="-1"
    >
      <Icon name="arrow-right" size={16} />
    </button>
    <div class="home-pillnav-fade home-pillnav-fade--left" aria-hidden="true"></div>
    <div class="home-pillnav-track" id="home-pillnav-track" role="list">
      {pillFeatures.map((p) => (
        <a href={p.href} class="home-pillnav-item" role="listitem">
          <span class="home-pillnav-icon"><Icon name={p.icon} size={16} /></span>
          <span>{p.title}</span>
        </a>
      ))}
    </div>
    <div class="home-pillnav-fade home-pillnav-fade--right" aria-hidden="true"></div>
    <button
      type="button"
      class="home-pillnav-arrow home-pillnav-arrow--right"
      id="home-pillnav-next"
      aria-label="Scroll features right"
    >
      <Icon name="arrow-right" size={16} />
    </button>
  </div>

  <!-- Showcase features: alternating text + screenshot layout -->
  <div class="space-y-20 lg:space-y-28">
    {showcaseFeatures.map((feature, index) => (
      <div class:list={[
        'grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center feature-row',
        index % 2 === 1 && 'lg:direction-rtl',
      ]}>
        <div class:list={['lg:direction-ltr', index % 2 === 1 && 'lg:order-2']}>
          <div class="inline-flex items-center justify-center h-12 w-12 rounded-xl bg-[var(--color-primary-100)] text-[var(--color-primary)] mb-4" data-icon-hover>
            <Icon name={feature.icon} size={24} />
          </div>
          <h3 class="text-2xl font-bold mb-3 text-[var(--dw-text)]">{feature.title}</h3>
          <p class="text-[var(--dw-text-secondary)] leading-relaxed mb-6">{feature.description}</p>
          <a
            href={feature.href}
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--color-primary)] hover:text-[var(--color-primary-light)] transition-colors"
          >
            Learn more
            <Icon name="arrow-right" size={16} />
          </a>
        </div>
        <div class:list={[index % 2 === 1 && 'lg:order-1']}>
          <AppScreenshot
            src={feature.screenshot}
            alt={feature.screenshotAlt}
          />
        </div>
      </div>
    ))}
  </div>

  <!-- Three more features: balanced 3-col grid -->
  <div class="mt-20 lg:mt-28 pt-16 border-t border-[var(--dw-border)]">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-xs font-semibold tracking-widest uppercase text-[var(--color-primary)]">And that's not all</span>
      <h3 class="mt-2 text-2xl sm:text-3xl font-bold text-[var(--dw-text)]" style="font-family: var(--font-headline, 'Manrope', sans-serif);">
        Three more powerful suites
      </h3>
      <p class="mt-3 text-[var(--dw-text-secondary)] leading-relaxed">
        Because ranking in modern search takes more than keywords alone.
      </p>
    </div>
    <div class="suites-grid">
      {compactFeatures.map((feature) => (
        <a href={feature.href} class="suite-card group">
          <div class="suite-icon" data-icon-hover>
            <Icon name={feature.icon} size={24} />
          </div>
          <h4 class="suite-title">{feature.title}</h4>
          <p class="suite-desc">{feature.description}</p>
          <span class="suite-link">
            Explore
            <Icon name="arrow-right" size={14} />
          </span>
        </a>
      ))}
    </div>
  </div>
</Section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { batchReveal } from '../../scripts/animations';

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotion) {
    // Heading fade up
    gsap.from('.feature-heading', {
      y: 30, opacity: 0, duration: 0.6, ease: 'power3.out',
      scrollTrigger: { trigger: '.feature-heading', start: 'top 85%', once: true },
    });

    gsap.from('.feature-sub', {
      y: 20, opacity: 0, duration: 0.5, ease: 'power3.out', delay: 0.15,
      scrollTrigger: { trigger: '.feature-sub', start: 'top 85%', once: true },
    });

    // Feature rows: text slides from left, image from right
    document.querySelectorAll('.feature-row').forEach((row, i) => {
      const textCol = row.children[0] as HTMLElement;
      const imgCol = row.children[1] as HTMLElement;
      const fromLeft = i % 2 === 0;

      gsap.from(textCol, {
        x: fromLeft ? -60 : 60,
        opacity: 0,
        duration: 0.7,
        ease: 'power3.out',
        scrollTrigger: { trigger: row, start: 'top 75%', once: true },
      });

      gsap.from(imgCol, {
        x: fromLeft ? 60 : -60,
        opacity: 0,
        duration: 0.7,
        ease: 'power3.out',
        delay: 0.15,
        scrollTrigger: { trigger: row, start: 'top 75%', once: true },
      });
    });
  }

  // Suite cards are visible by default (no entrance animation). Mouse-follow glow only.
  document.querySelectorAll('.suite-card').forEach((item) => {
    const el = item as HTMLElement;
    el.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = el.getBoundingClientRect();
      el.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
      el.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
    });
  });

  /* ---------- Home pills: horizontal scroll + arrows + edge fades ---------- */
  const pillWrap = document.querySelector<HTMLElement>('.home-pillnav-wrap');
  const pillTrack = document.getElementById('home-pillnav-track') as HTMLElement | null;
  const pillPrev = document.getElementById('home-pillnav-prev') as HTMLButtonElement | null;
  const pillNext = document.getElementById('home-pillnav-next') as HTMLButtonElement | null;

  if (pillWrap && pillTrack) {
    const updatePillState = () => {
      const max = pillTrack.scrollWidth - pillTrack.clientWidth;
      const left = pillTrack.scrollLeft;
      const canLeft = left > 4;
      const canRight = left < max - 4;
      pillWrap.classList.toggle('can-scroll-left', canLeft);
      pillWrap.classList.toggle('can-scroll-right', canRight);
      pillPrev?.setAttribute('aria-disabled', String(!canLeft));
      pillNext?.setAttribute('aria-disabled', String(!canRight));
    };
    const scrollPills = (dir: 1 | -1) => {
      const step = Math.max(pillTrack.clientWidth * 0.8, 200);
      pillTrack.scrollBy({ left: dir * step, behavior: 'smooth' });
    };
    pillTrack.addEventListener('scroll', updatePillState, { passive: true });
    window.addEventListener('resize', updatePillState);
    pillPrev?.addEventListener('click', () => scrollPills(-1));
    pillNext?.addEventListener('click', () => scrollPills(1));
    requestAnimationFrame(updatePillState);
  }
</script>

<style>
  /* Home pill quick-nav */
  .home-pillnav-wrap {
    position: relative;
    display: flex;
    align-items: center;
    max-width: 80rem;
    margin: 0 auto;
    padding: 0;
  }

  .home-pillnav-track {
    flex: 1;
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0.25rem 0.25rem 0.5rem;
    scroll-behavior: smooth;
  }
  .home-pillnav-track::-webkit-scrollbar { display: none; }

  .home-pillnav-item {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1rem;
    border-radius: 9999px;
    background: var(--dw-surface);
    border: 1px solid var(--dw-border);
    color: var(--dw-text-secondary);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .home-pillnav-item:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
    transform: translateY(-1px);
  }

  .home-pillnav-icon {
    display: inline-flex;
    color: var(--color-primary);
  }

  .home-pillnav-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3rem;
    pointer-events: none;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .home-pillnav-fade--left {
    left: 0;
    background: linear-gradient(to right, var(--dw-surface), color-mix(in srgb, var(--dw-surface) 0%, transparent));
  }
  .home-pillnav-fade--right {
    right: 0;
    background: linear-gradient(to left, var(--dw-surface), color-mix(in srgb, var(--dw-surface) 0%, transparent));
  }
  .home-pillnav-wrap.can-scroll-left .home-pillnav-fade--left { opacity: 1; }
  .home-pillnav-wrap.can-scroll-right .home-pillnav-fade--right { opacity: 1; }

  .home-pillnav-arrow {
    position: relative;
    z-index: 3;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid var(--dw-border);
    background: var(--dw-surface);
    color: var(--dw-text-secondary);
    cursor: pointer;
    transition: opacity 0.25s ease, color 0.2s ease, border-color 0.2s ease;
    margin: 0 0.5rem;
    padding: 0;
  }
  .home-pillnav-arrow:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }
  .home-pillnav-arrow--left :global(svg) { transform: rotate(180deg); }
  .home-pillnav-arrow[aria-disabled="true"] {
    opacity: 0;
    pointer-events: none;
  }
  @media (max-width: 640px) {
    .home-pillnav-arrow { display: none; }
  }

  .suites-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .suites-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  .suite-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 2rem;
    border-radius: 20px;
    border: 1px solid var(--dw-border);
    background: var(--dw-surface);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.3s ease, box-shadow 0.4s ease;
    isolation: isolate;
    min-height: 260px;
  }

  .suite-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      420px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(0, 82, 50, 0.1),
      transparent 60%
    );
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
    z-index: 1;
  }

  .suite-card::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-primary), #2ecc71);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .suite-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-primary);
    box-shadow: 0 20px 40px -14px rgba(0, 82, 50, 0.2);
  }

  .suite-card:hover::before { opacity: 1; }
  .suite-card:hover::after { transform: scaleX(1); }

  .suite-icon {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--dw-accent-bg);
    color: var(--color-primary);
    margin-bottom: 1.25rem;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), background 0.3s ease, color 0.3s ease;
  }

  .suite-card:hover .suite-icon {
    transform: scale(1.08) rotate(-5deg);
    background: var(--color-primary);
    color: #ffffff;
  }

  .suite-title {
    position: relative;
    z-index: 2;
    font-family: var(--font-headline, 'Manrope', sans-serif);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--dw-text);
    line-height: 1.3;
    margin-bottom: 0.55rem;
  }

  .suite-desc {
    position: relative;
    z-index: 2;
    flex: 1;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--dw-text-secondary);
  }

  .suite-link {
    position: relative;
    z-index: 2;
    margin-top: 1.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary);
    transition: gap 0.3s ease;
  }

  .suite-card:hover .suite-link {
    gap: 0.65rem;
  }
</style>
